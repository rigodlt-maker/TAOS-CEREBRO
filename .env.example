# Supabase (Project Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Único correo con acceso
ALLOWED_EMAIL=tu@correo.com

# Correos de vencimiento (Resend)
RESEND_API_KEY=re_...

# Protege la ruta del cron (Vercel lo manda solo)
CRON_SECRET=una-frase-larga-al-azar

# Opcional: IA de Anthropic. Sin esto, la app usa reglas gratis.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
